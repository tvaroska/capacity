# GSU capacity (tokens per minute per GSU) — source: docs.cloud.google.com/gemini-enterprise-agent-platform/models/provisioned-throughput/supported-models
# Formula: per-second throughput * 60

# Gemini 2.5
GSU_CAPACITY_GEMINI_2_5_PRO=39000
GSU_CAPACITY_GEMINI_2_5_FLASH=161400
GSU_CAPACITY_GEMINI_2_5_FLASH_IMAGE=161400
GSU_CAPACITY_GEMINI_2_5_FLASH_LITE=484200
GSU_CAPACITY_GEMINI_LIVE_2_5_FLASH_NATIVE_AUDIO=97200

# Gemini 3
GSU_CAPACITY_GEMINI_3_PRO_IMAGE=30000
GSU_CAPACITY_GEMINI_3_FLASH=120900

# Gemini 3.1
GSU_CAPACITY_GEMINI_3_1_PRO=30000
GSU_CAPACITY_GEMINI_3_1_FLASH_IMAGE=120900
GSU_CAPACITY_GEMINI_3_1_FLASH_LITE=241800

# Gemini 3.5
GSU_CAPACITY_GEMINI_3_5_FLASH=40500
